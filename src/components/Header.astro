---
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/finance">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" style="display:inline;vertical-align:middle;margin-right:6px;">
				<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
			</svg>
			{SITE_TITLE}
		</a></h2>
		<div class="internal-links">
			<a href="/finance" class={Astro.url.pathname === '/finance' || Astro.url.pathname === '/finance/' ? 'active' : ''}>Dashboard</a>
			<a href="/" class={Astro.url.pathname === '/' ? 'active' : ''}>AI Insights</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1.5em;
		background: #0f172a;
		box-shadow: 0 2px 12px rgba(0,0,0,0.3);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: #f1f5f9;
		display: flex;
		align-items: center;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 56px;
	}
	nav a {
		padding: 0.5em 1em;
		color: #94a3b8;
		border-bottom: 3px solid transparent;
		text-decoration: none;
		font-size: 0.9em;
		font-weight: 500;
		transition: color 0.2s;
	}
	nav a:hover {
		color: #f1f5f9;
	}
	nav a.active {
		color: #38bdf8;
		border-bottom-color: #38bdf8;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25em;
	}
</style>
