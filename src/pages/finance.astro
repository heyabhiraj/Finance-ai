    <BaseHead
      title="Smart Finance Optimizer"
      description="OR-powered savings planner with AI financial strategist. Upload your statement, set a savings goal, and get data-driven recommendations."
    />
  </head>
  <body>
    <Header />
    <main>
      <BudgetOptimizer client:load />
    </main>
    <Footer />
  </body>
</html>
